// ─────────────────────────────────────────────────────────────────────────────
// DO NOT CHANGE THIS FILE. It belongs to the devcontainer template and is
// overwritten whenever the template is updated. Your project's settings go in
// tools.sh, domains.conf, firewall.sh and docker-compose.override.yml.
//
// Paths below are relative to THIS file, i.e. to .devcontainer/.template/.
// start.sh and attach.sh point the devcontainer CLI here with --config, which is
// why this file does not need to sit at the path the CLI discovers by itself.
// ─────────────────────────────────────────────────────────────────────────────
{
  "name": "__PROJECT_NAME__",
  "dockerComposeFile": [
    "docker-compose.yml",
    "../docker-compose.override.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/aivar-codeborne/devcontainer-features/claude:1.0.7": {},
    // Substituted by the installer. Present only when the install mounted the
    // host Docker socket, because without the socket there is no daemon to reach.
    __DOCKER_FEATURE__
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils:2"
  ],
  "remoteUser": "dev"
}
