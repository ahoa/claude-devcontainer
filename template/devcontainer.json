// ─────────────────────────────────────────────────────────────────────────────
// DO NOT CHANGE THIS FILE. It belongs to the devcontainer template and is
// overwritten whenever the template is updated. Your project's settings go in
// tools.sh, domains.conf, ports.conf and docker-compose.override.yml.
//
// This file has to sit at exactly .devcontainer/devcontainer.json for VS Code and
// the devcontainer CLI to find it, so unlike the rest of the machinery it cannot
// move into .template/.
// ─────────────────────────────────────────────────────────────────────────────
{
  "name": "__PROJECT_NAME__",
  "dockerComposeFile": [
    ".template/docker-compose.yml",
    "docker-compose.override.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/aivar-codeborne/devcontainer-features/claude:1.0.7": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils:2"
  ],
  "remoteUser": "dev"
}
