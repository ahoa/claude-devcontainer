// ─────────────────────────────────────────────────────────────────────────────
// DO NOT CHANGE THIS FILE. It belongs to the devcontainer template and is
// overwritten whenever the template is updated. Your project's settings go in
// tools.sh, domains.conf, firewall.sh and docker-compose.override.yml.
//
// Paths below are relative to THIS file, i.e. to .devcontainer/.template/.
// start.sh and attach.sh point the devcontainer CLI here with --config, which is
// why this file does not need to sit at the path the CLI discovers by itself.
// ─────────────────────────────────────────────────────────────────────────────
{
  "name": "__PROJECT_NAME__",
  "dockerComposeFile": [
    "docker-compose.yml",
    "../docker-compose.override.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspace/__PROJECT_NAME__",
  "shutdownAction": "stopCompose",
  // The firewall, then the watcher that keeps it current: it resolves the
  // allowed hosts again every few minutes, from the domains.conf in the
  // read-only mount, so neither a rotating CDN address nor a new host needs a
  // rebuild. --start
  // returns at once (the CLI waits for this command), and replaces the watcher
  // an earlier start left running. Codex does not start when CODEX_HOME is
  // missing. The directory is in the Claude config volume, which hides the
  // image's copy, so the start command makes it.
  //
  // A config volume that belongs to another UID gets its owner from start.sh, on
  // the host, before `up`. A chown here would need sudo, and with --docker off dev
  // has sudo for the firewall script only.
  "postStartCommand": "mkdir -p -m 700 \"$CODEX_HOME\" && sudo /usr/local/bin/init-firewall.sh && .devcontainer/.template/fw-watch.sh --start",
  // Runs on the HOST, before the mount. A missing source makes a bind mount
  // fail, and the container does not start.
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude/plugins/cache/codeborne/claude-agents",
  // The claude feature writes its own claude() into ~/.zshrc after the image
  // build, so the Dockerfile cannot override it. Append ours after it, once per
  // container creation.
  "postCreateCommand": "grep -q CA_PLUGIN_CACHE ~/.zshrc || cat .devcontainer/.template/ca-claude.zsh >> ~/.zshrc",
  // common-utils, claude and github-cli are in the base image (base/devcontainer.json).
  "features": {
    // Substituted by the installer. Present only when the install asked for the
    // host Docker socket (--docker on). The feature mounts the socket itself, at
    // /var/run/docker-host.sock, and its entrypoint proxies it to
    // /var/run/docker.sock for dev. docker-compose.yml must not mount the socket
    // as well, see the note there. docker-check.sh tells when the proxy is gone.
    __DOCKER_FEATURE__
  },
  "remoteUser": "dev"
}
